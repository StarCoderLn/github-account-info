VITE_SERVER_URL=http://localhost:3000
VITE_GO_API_URL=http://localhost:8080

# 可选：本地只启动 Web 时，通过 Vite 代理复用已部署的 Node API。
# VITE_SERVER_URL=http://localhost:3001/api
# LOCAL_API_PROXY_TARGET=https://<api-id>.execute-api.<region>.amazonaws.com
# Normally derived from CF_PAGES_COMMIT_SHA for preview builds.
# VITE_PREVIEW_KEY=preview-0123456789ab
