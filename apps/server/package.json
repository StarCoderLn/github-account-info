{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "node build.mjs",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch --env-file=.env --env-file=.env.local src/index.ts",
		"start": "node dist/index.mjs",
		"test": "SKIP_ENV_VALIDATION=true tsx --test src/**/*.test.ts"
	},
	"dependencies": {
		"@github-account-info/api": "workspace:*",
		"@github-account-info/db": "workspace:*",
		"@github-account-info/env": "workspace:*",
		"@github-account-info/performance-schema": "workspace:*",
		"@hono/node-server": "^1.14.4",
		"@hono/trpc-server": "^0.4.0",
		"@trpc/server": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@github-account-info/config": "workspace:*",
		"@types/node": "catalog:",
		"esbuild": "^0.28.1",
		"tsx": "^4.19.2",
		"typescript": "catalog:"
	}
}
